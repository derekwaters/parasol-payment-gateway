<?xml version="1.0" encoding="UTF-8"?>
<settings xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd" xmlns="http://maven.apache.org/SETTINGS/1.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <mirrors>
    <mirror>
      <id>maven-default-http-blocker</id>
      <url>http://{{ jfrog_hostname }}:8082</url>
      <mirrorOf>dummy</mirrorOf>
      <blocked>false</blocked>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <username>{{ jfrog_maven_username }}</username>
      <password>{{ jfrog_maven_token }}</password>
      <id>central</id>
    </server>
  </servers>
  <profiles>
    <profile>
      <repositories>
        <repository>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <id>central</id>
          <name>{{ jfrog_lightwell_reponame }}</name>
          <url>http://{{ jfrog_hostname }}:8082/artifactory/{{ jfrog_lightwell_reponame }}</url>
        </repository>
      </repositories>
      <id>artifactory</id>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>artifactory</activeProfile>
  </activeProfiles>
</settings>